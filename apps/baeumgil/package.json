{
  "name": "baeumgil",
  "version": "0.1.0",
  "private": true,
  "description": "배움길 해커톤 MVP: 브라우저 앱과 Node.js 로컬 서버(/api/ai)",
  "//": "type 필드는 두지 않는다. tests/diagnostic.test.js가 vendor/katex를 CommonJS로 불러오기 때문이다. ESM .js는 Node가 문법으로 판별하고, 그 안내 경고만 끈다.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server.mjs",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --watch server.mjs",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test",
    "ai:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ai/check.mjs",
    "ai:prompt": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ai/check.mjs --prompt-only",
    "ai:lab": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON server/ai/check.mjs --lab"
  }
}
