{
  "concepts": [
    {
      "id": "c-int-addsub",
      "name": "정수의 덧셈과 뺄셈 (부호)",
      "summary": "음수를 빼는 것은 그 수의 절댓값을 더하는 것과 같다. 예: 3 - (-2) = 3 + 2",
      "prerequisiteIds": []
    },
    {
      "id": "c-int-mul",
      "name": "정수의 곱셈과 나눗셈 (부호)",
      "summary": "같은 부호끼리 곱하거나 나누면 양수, 다른 부호끼리는 음수이다.",
      "prerequisiteIds": []
    },
    {
      "id": "c-frac-reciprocal",
      "name": "분수의 나눗셈과 역수",
      "summary": "분수로 나누는 것은 그 분수의 역수를 곱하는 것과 같다. 예: a ÷ (b/c) = a × (c/b)",
      "prerequisiteIds": [
        "c-int-mul"
      ]
    },
    {
      "id": "c-rat-calc",
      "name": "부호가 있는 유리수의 혼합 계산",
      "summary": "곱셈·나눗셈을 먼저 하고 덧셈·뺄셈을 나중에 하며, 각 단계에서 부호를 확인한다.",
      "prerequisiteIds": [
        "c-int-addsub",
        "c-int-mul",
        "c-frac-reciprocal"
      ]
    },
    {
      "id": "c-distribute-sign",
      "name": "분배법칙과 부호",
      "summary": "괄호 앞의 수를 괄호 안의 모든 항에 부호까지 곱한다. 예: -3(x - 2) = -3x + 6",
      "prerequisiteIds": [
        "c-int-mul"
      ]
    },
    {
      "id": "c-eq-transpose",
      "name": "등식의 성질과 이항",
      "summary": "등식의 양변에 같은 수를 더하거나 빼도 등식은 성립하므로, 항을 반대편으로 옮기면 부호가 바뀐다.",
      "prerequisiteIds": [
        "c-int-addsub"
      ]
    },
    {
      "id": "c-eq-solve",
      "name": "괄호가 있는 일차방정식의 풀이",
      "summary": "괄호를 풀고, x항과 상수항을 양쪽으로 모은 뒤, x의 계수로 양변을 나눈다.",
      "prerequisiteIds": [
        "c-distribute-sign",
        "c-eq-transpose"
      ]
    },
    {
      "id": "astra-algebra-l3-다항식의 덧셈",
      "name": "다항식의 덧셈",
      "summary": "$A+B=(2+a)x^2+4x$이므로 $a=-2$, $b=4$. 따라서 $a+b=2$.",
      "prerequisiteIds": [
        "road-like"
      ]
    },
    {
      "id": "astra-algebra-l3-인수분해",
      "name": "인수분해",
      "summary": "합의 세제곱 인수분해 공식으로 $x^3+2^3=(x+2)(x^2-2x+4)$이므로 $a=-2$.",
      "prerequisiteIds": [
        "astra-algebra-l2-인수분해"
